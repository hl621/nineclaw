# Normalize line endings across Windows / Linux / macOS.
# Repository stores LF; Windows scripts keep CRLF where the runtime expects it.

* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.whl binary
