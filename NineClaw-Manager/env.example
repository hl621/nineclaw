# ─── 常用部署配置 ───────────────────────────────────────────────────────────
# Manager 通过 Traefik 管理 NineClaw 实例路由、dashboard 和 WebSearch。
# 机器 IP 或 Traefik 对外端口变化时，优先修改这里。
# 本地宿主机开发通常可设为 http://127.0.0.1:8510。
PUBLIC_TRAEFIK_URL=

# Docker Compose 绑定到宿主机、可从外部访问的端口。
# 如果 PUBLIC_TRAEFIK_PORT 变化，对外访问地址也要同步体现在 PUBLIC_TRAEFIK_URL。
PUBLIC_MANAGER_PORT=8000
PUBLIC_POSTGRES_PORT=15432
PUBLIC_TRAEFIK_PORT=8510
PUBLIC_TRAEFIK_DASHBOARD_PORT=8511
PUBLIC_OPENSANDBOX_PORT=8090

# 同一个 token 会写入每个 NineClaw 容器，并由 Traefik 注入代理请求。
# 请在真实 .env 中替换为部署环境自己的值。
NINECLAW_TOKEN=sk-thedefaultkeybyqiyuanlab

# 创建实例时的镜像版本由前端下拉选择（Manager 通过 Docker 本地镜像列表提供）。
# 可选：覆盖用于过滤镜像标签的仓库名，默认 nineclaw。
# NINECLAW_IMAGE_REPOSITORY=nineclaw

# 本地开发连接 docker-compose.yml 暴露到宿主机的 Postgres 端口。
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:15432/nineclaw_manager
DATABASE_ECHO=false

# ─── Docker engine ──────────────────────────────────────────────────────────
# Manager 默认使用本机 Docker socket 创建、启动和停止 NineClaw 容器。
# 远程 Docker 请在前端「系统设置」里配置 SSH 地址，不要改这里。
DOCKER_URL=unix:///var/run/docker.sock

# Manager 调用 Traefik 的地址。PUBLIC_TRAEFIK_URL 为空时回退到这里。
TRAEFIK_INTERNAL_URL=http://traefik:80
# Manager 进程自己访问 Traefik 的地址。Docker 部署中应使用容器网络地址；
# 本地宿主机运行 Manager 时可留空，让它回退到 PUBLIC_TRAEFIK_URL。
MANAGER_TRAEFIK_URL=

# Manager 镜像默认必须单 worker，因为创建进度流使用进程内 job registry。
NINECLAW_MANAGER_WORKERS=1

# ─── NineClaw instance ──────────────────────────────────────────────────────
NINECLAW_COMMAND=["gateway", "run", "--replace"]
NINECLAW_NETWORK=qiyuan_net

# 每个 NineClaw 实例占用 3 个连续宿主机端口时使用的自动分配范围。
NINECLAW_PORT_RANGE_START=33000
NINECLAW_PORT_RANGE_END=40000

# 三个内部端口顺序为 gateway, webui, dashboard。
NINECLAW_INTERNAL_PORTS=[8642, 8643, 8644]
NINECLAW_PUBLISH_HOST_PORTS=false
NINECLAW_CONTAINER_NAME_PREFIX=nineclaw
NINECLAW_LABEL_PREFIX=orchestrator

# 实例默认资源。
NINECLAW_DEFAULT_MEMORY=4G
NINECLAW_DEFAULT_CPUS=2.0
NINECLAW_SHM_SIZE=2g
NINECLAW_RESTART_POLICY=unless-stopped

# 创建实例后推送到 Hermes dashboard 的默认配置和环境变量。
NINECLAW_DEFAULT_CONFIG={"agent.max_turns": 50}
# 可选：为新实例预置 Hermes 内置 Provider 环境变量（JSON 对象）。
# 例如 MoA 默认预设需要的 OpenRouter：
# NINECLAW_DEFAULT_ENV={"OPENROUTER_API_KEY":"sk-or-..."}
NINECLAW_DEFAULT_ENV={}

# 默认 OpenAI-compatible provider。四个值都设置后才会注入；留空则跳过。
NINECLAW_CUSTOM_PROVIDER_NAME=
NINECLAW_CUSTOM_PROVIDER_BASE_URL=
NINECLAW_CUSTOM_PROVIDER_API_KEY=
NINECLAW_CUSTOM_PROVIDER_MODEL=

# ─── NineClaw routing and bootstrap ─────────────────────────────────────────
# {instance_id} 会在运行时替换。
TRAEFIK_ENTRYPOINT=web
NINECLAW_ROUTE_GATEWAY=/traefik/nineclaw/{instance_id}/gateway
NINECLAW_ROUTE_WEBUI=/traefik/nineclaw/{instance_id}/webui
NINECLAW_ROUTE_DASHBOARD=/traefik/nineclaw/{instance_id}/dashboard

# 创建后等待 NineClaw dashboard 就绪的最长秒数。
NINECLAW_BOOTSTRAP_TIMEOUT=60.0
NINECLAW_BOOTSTRAP_RESTART_GATEWAY=true

# ─── Knowledge ──────────────────────────────────────────────────────────────
KNOWLEDGE_STORAGE_PATH=./knowledge_storage
KNOWLEDGE_MAX_UPLOAD_SIZE=52428800

# Knowledge backend: filesystem 或 ragflow。
# 外部 RAG 服务的 base_url 和 api_key 来自数据库配置（知识库设置页面）。
# 部署到 Hermes 时会转换为 QYRAG_* 变量。
KNOWLEDGE_BACKEND=filesystem

# ─── Skills ─────────────────────────────────────────────────────────────────
SKILLS_STORAGE_PATH=./skills_storage
SKILLS_MAX_UPLOAD_SIZE=52428800

# ─── OpenSandbox ────────────────────────────────────────────────────────────
# 设置 OPEN_SANDBOX_DOMAIN 后使用 OpenSandbox；留空则使用本地 subprocess。
OPEN_SANDBOX_DOMAIN=
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_IMAGE=nineclaw-sandbox:latest
# OPEN_SANDBOX_API_KEY=  # 自托管部署通常不需要。

# NineClaw Sandbox service，用于持久搜索。
NINECLAW_SANDBOX_URL=http://nineclaw-sandbox:8001

# ─── FastAPI ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Jobs ───────────────────────────────────────────────────────────────────
# 当前实现为进程内内存队列，用于先打通 Job/Event 抽象。
# 注意：memory 模式不跨 worker、不抗重启；后续会扩展为 redis。
JOB_BACKEND=memory

# ─── External dependency bulkheads ──────────────────────────────────────────
# 这些配置只控制外部依赖隔离槽和内部排队时间，不限制任务总运行时长。
EXTERNAL_QUEUE_WAIT_TIMEOUT_SECONDS=1.0
EXTERNAL_RAGFLOW_MAX_CONCURRENCY=4

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]
CORS_ORIGIN_REGEX=.*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_EXPOSE_HEADERS=["*"]
CORS_MAX_AGE=86400

# ─── Interactive terminals ─────────────────────────────────────────────────
TERMINAL_MAX_SESSIONS_PER_INSTANCE=6
TERMINAL_IDLE_TIMEOUT_SECONDS=60
TERMINAL_CLEANUP_INTERVAL_SECONDS=15
TERMINAL_RESIZE_TIMEOUT_SECONDS=1.0

# ─── Tenant defaults ────────────────────────────────────────────────────────
DEFAULT_TENANT_ID=default
