map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API 代理 → NineClawManager（实例编排 / knowledge / providers 等）
    location /v1/ {
        proxy_pass ${PUBLIC_BACKEND_URL}/v1/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # SSE 支持
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    # Traefik 路由代理（实例 gateway/webui/dashboard + Hermes SSE）
    location /traefik/ {
        proxy_pass ${PUBLIC_TRAEFIK_URL}/traefik/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Hermes webui API requires forwarded headers when reached via this SPA proxy.
        proxy_set_header X-Forwarded-Host ${PUBLIC_TRAEFIK_FORWARDED_HOST};
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "close";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    # WebSearch 代理
    location /ws-api/ {
        proxy_pass ${PUBLIC_WEBSEARCH_URL}/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    # Hashed build assets — must not fall through to SPA (otherwise .mjs returns index.html)
    location ^~ /assets/ {
        try_files $uri =404;
        default_type application/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
