{
  "name": "GitHub仓库",
  "description": "GitHub 仓库搜索（按 star 排序）",
  "enabled": true,
  "url_base": "https://github.com",
  "request": {
    "url": "https://api.github.com/search/repositories",
    "method": "GET",
    "params": [
      {
        "key": "q",
        "value": "{query}"
      },
      {
        "key": "sort",
        "value": "stars"
      },
      {
        "key": "order",
        "value": "desc"
      }
    ],
    "headers": [
      {
        "key": "Accept",
        "value": "application/vnd.github+json"
      },
      {
        "key": "User-Agent",
        "value": "NineClaw-WebSearch/1.0"
      }
    ],
    "body": "",
    "body_type": "application/json",
    "proxy_pool": []
  }
}
