{
  "name": "爱奇艺",
  "description": "爱奇艺站内搜索 JSON API，返回影视剧集结果",
  "enabled": true,
  "url_base": "https://www.iqiyi.com",
  "request": {
    "url": "https://mesh.if.iqiyi.com/portal/lw/search/homePageV3",
    "method": "GET",
    "params": [
      {
        "key": "key",
        "value": "{query}"
      },
      {
        "key": "pageNum",
        "value": "1"
      },
      {
        "key": "pageSize",
        "value": "25"
      }
    ],
    "headers": [
      {
        "key": "User-Agent",
        "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
      },
      {
        "key": "Referer",
        "value": "https://so.iqiyi.com/"
      }
    ],
    "body": "",
    "body_type": "application/json",
    "proxy_pool": []
  }
}
