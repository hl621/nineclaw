{
  "name": "夸克搜索",
  "description": "夸克/神马搜索（quark.sm.cn）",
  "enabled": true,
  "url_base": "https://quark.sm.cn",
  "tags": ["general"],
  "request": {
    "url": "https://quark.sm.cn/s",
    "method": "GET",
